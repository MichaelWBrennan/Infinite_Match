# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Database Configuration
# Document store: FerretDB (Apache-2.0, MongoDB-wire-compatible on Postgres).
MONGODB_URI=mongodb://localhost:27017/match3game
MONGODB_MAX_POOL_SIZE=10
MONGODB_TIMEOUT=5000
MONGODB_SOCKET_TIMEOUT=45000

REDIS_URL=redis://localhost:6379
REDIS_RETRY_DELAY=100
REDIS_MAX_RETRIES=3

# Data layer: PostgREST over PostgreSQL (open source, self-hosted).
# SUPABASE_URL / SUPABASE_ANON_KEY are accepted as legacy aliases.
POSTGREST_URL=http://localhost:3001
POSTGREST_TOKEN=

# Object storage: MinIO (S3-compatible, AGPL-3.0)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=match3game

# Email: SMTP (Mailpit in development, any SMTP server in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# AI: local, open-weights models via Ollama (or any OpenAI-compatible server
# such as vLLM / LiteLLM via OPENAI_BASE_URL). A hosted OPENAI_API_KEY is
# only needed when no self-hosted model server is configured.
OLLAMA_BASE_URL=
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=
# HF_INFERENCE_URL=  (HF-Inference-compatible endpoint for textGeneration)

# Push notifications. PUSH_TRANSPORT: ntfy | webpush | fcm | log
PUSH_TRANSPORT=ntfy
NTFY_URL=http://localhost:8081
NTFY_TOKEN=
# W3C Web Push (PUSH_TRANSPORT=webpush):
# VAPID_SUBJECT=mailto:ops@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# FCM HTTP v1 compatibility adapter (PUSH_TRANSPORT=fcm), no firebase-admin:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_API_VERSION=2023-10-16
STRIPE_CURRENCY=usd
STRIPE_COUNTRY=US
# Hosted Stripe Checkout (coin packs). Checkout is refused until both URLs are set.
STRIPE_CHECKOUT_SUCCESS_URL=https://your-host/?purchase=success
STRIPE_CHECKOUT_CANCEL_URL=https://your-host/

# Apple App Store Configuration
# Apple Root CA - G3 PEM (https://www.apple.com/certificateauthority/). Subscription
# notifications are refused until this is set.
APPLE_SHARED_SECRET=your-apple-shared-secret
APPLE_ROOT_CA_G3=
# Store purchases (/api/monetization/receipt/verify). The bundle ID must match the app.
# Sandbox receipts are refused unless APPLE_ALLOW_SANDBOX=true (for testing only).
APPLE_BUNDLE_ID=
APPLE_ALLOW_SANDBOX=false

# Google Real-time Developer Notifications (Pub/Sub push). Refused until both are set.
GOOGLE_RTDN_AUDIENCE=https://your-host/api/subscriptions/google
GOOGLE_RTDN_SERVICE_ACCOUNT=rtdn@your-project.iam.gserviceaccount.com

# Operator tools (/api/admin). Admin access is refused unless both are set.
# ADMIN_API_TOKEN must be at least 32 characters. Send it in x-admin-token with x-admin-id.
ADMIN_API_TOKEN=
ADMIN_IDS=

# Player economy storage. Set to mongo in production: coins bought with real money are
# credited only when this is set, so balances survive a restart. Uses AppConfig database URL.
ECONOMY_STORE=

# Google Play Configuration
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=path/to/google-service-account.json
# Android package name the purchase must belong to. Purchases are refused until it is set.
GOOGLE_PACKAGE_NAME=

# Live ops: dated events and time-boxed deals. Defaults to config/liveops.json.
# Read once at startup; restart the server after editing.
# LIVE_OPS_CONFIG=config/liveops.json

# Pricing Configuration
DEFAULT_CURRENCY=USD
COUNTRY_OVERRIDES_PATH=config/pricing/overrides.json

# Analytics: PostHog (self-hosted by default; leave empty to log locally)
POSTHOG_API_KEY=
POSTHOG_HOST=http://localhost:8000

# Error tracking: GlitchTip (MIT, Sentry-SDK-compatible). Invalid or
# placeholder DSNs are ignored at boot.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d

# Game Configuration
GAME_MAX_LEVEL=1000
GAME_MAX_SCORE=999999
GAME_POWERUP_MAX_COUNT=10
GAME_POWERUP_COOLDOWN=5000
GAME_BOARD_SIZE=8
GAME_COLORS=red,blue,green,yellow,purple,orange
GAME_MIN_MATCH=3
# Optional weather influence on procedural levels (no key; respects MET Norway CC BY 4.0/fair use).
# Default: metno. Use off to disable all feed traffic. Tests default to off.
LEVEL_WEATHER_PROVIDER=metno
LEVEL_WEATHER_USER_AGENT=InfiniteMatch/2.0 github.com/MichaelWBrennan/Infinite_Match
LEVEL_WEATHER_CACHE_AREAS=512
LEVEL_WEATHER_REQUESTS_PER_SECOND=4
# Optional self-hosted Open-Meteo-compatible endpoint; never supplied by a player.
# Hosted free Open-Meteo is non-commercial, not a default for commercial deployments.
# LEVEL_WEATHER_PROVIDER=open-meteo
# LEVEL_WEATHER_OPEN_METEO_URL=http://weather:8080/v1/forecast
