# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/match3game
MONGODB_MAX_POOL_SIZE=10
MONGODB_TIMEOUT=5000
MONGODB_SOCKET_TIMEOUT=45000

REDIS_URL=redis://localhost:6379
REDIS_RETRY_DELAY=100
REDIS_MAX_RETRIES=3

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket
AWS_SNS_TOPIC_ARN=your-sns-topic-arn
AWS_SQS_QUEUE_URL=your-sqs-queue-url
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=path/to/service-account-key.json

# Azure Configuration
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_COSMOS_ENDPOINT=your-cosmos-endpoint
AZURE_COSMOS_KEY=your-cosmos-key
AZURE_COSMOS_DATABASE=match3game

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_API_VERSION=2023-10-16
STRIPE_CURRENCY=usd
STRIPE_COUNTRY=US

# Apple App Store Configuration
# Apple Root CA - G3 PEM (https://www.apple.com/certificateauthority/). Subscription
# notifications are refused until this is set.
APPLE_SHARED_SECRET=your-apple-shared-secret
APPLE_ROOT_CA_G3=
# Store purchases (/api/monetization/receipt/verify). The bundle ID must match the app.
# Sandbox receipts are refused unless APPLE_ALLOW_SANDBOX=true (for testing only).
APPLE_BUNDLE_ID=
APPLE_ALLOW_SANDBOX=false

# Google Real-time Developer Notifications (Pub/Sub push). Refused until both are set.
GOOGLE_RTDN_AUDIENCE=https://your-host/api/subscriptions/google
GOOGLE_RTDN_SERVICE_ACCOUNT=rtdn@your-project.iam.gserviceaccount.com

# Operator tools (/api/admin). Admin access is refused unless both are set.
# ADMIN_API_TOKEN must be at least 32 characters. Send it in x-admin-token with x-admin-id.
ADMIN_API_TOKEN=
ADMIN_IDS=

# Google Play Configuration
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=path/to/google-service-account.json
# Android package name the purchase must belong to. Purchases are refused until it is set.
GOOGLE_PACKAGE_NAME=

# Live ops: dated events and time-boxed deals. Defaults to config/liveops.json.
# Read once at startup; restart the server after editing.
# LIVE_OPS_CONFIG=config/liveops.json

# Pricing Configuration
DEFAULT_CURRENCY=USD
COUNTRY_OVERRIDES_PATH=config/pricing/overrides.json

# Analytics Configuration
SENTRY_DSN=your-sentry-dsn
SENTRY_TRACES_SAMPLE_RATE=1.0

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d

# Game Configuration
GAME_MAX_LEVEL=1000
GAME_MAX_SCORE=999999
GAME_POWERUP_MAX_COUNT=10
GAME_POWERUP_COOLDOWN=5000
GAME_BOARD_SIZE=8
GAME_COLORS=red,blue,green,yellow,purple,orange
GAME_MIN_MATCH=3