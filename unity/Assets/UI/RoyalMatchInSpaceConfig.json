    "animation_configuration": {
      "button_hover": {
        "duration": 0.2,
        "ease_type": "EaseOut",
        "scale_from": [1.0, 1.0, 1.0],
        "scale_to": [1.05, 1.05, 1.0],
        "color_brightness": 1.2,
        "shadow_intensity": 1.3
      },
      "button_click": {
        "duration": 0.1,
        "ease_type": "EaseIn",
        "scale_from": [1.05, 1.05, 1.0],
        "scale_to": [0.95, 0.95, 1.0],
        "color_brightness": 0.8
      },
      "panel_slide_in": {
        "duration": 0.5,
        "ease_type": "EaseOut",
        "position_from": [-800, 0, 0],
        "position_to": [0, 0, 0],
        "alpha_from": 0.0,
        "alpha_to": 1.0,
        "scale_from": [0.8, 0.8, 1.0],
        "scale_to": [1.0, 1.0, 1.0]
      },
      "score_popup": {
        "duration": 1.5,
        "ease_type": "BounceOut",
        "scale_from": [0.5, 0.5, 1.0],
        "scale_to": [1.2, 1.2, 1.0],
        "position_offset": [0, 100, 0],
        "alpha_from": 0.0,
        "alpha_to": 1.0,
        "color_shift": [1.0, 0.85, 0.4, 1.0]
      },
      "star_pop": {
        "duration": 0.8,
        "ease_type": "BounceOut",
        "scale_from": [0.0, 0.0, 1.0],
        "scale_to": [1.2, 1.2, 1.0],
        "rotation_from": [0, 0, 0],
        "rotation_to": [0, 0, 360],
        "alpha_from": 0.0,
        "alpha_to": 1.0
      },
      "float": {
        "duration": 3.0,
        "ease_type": "EaseInOut",
        "position_offset": [0, 20, 0],
        "loop": true,
        "ping_pong": true
      }
    },
    
