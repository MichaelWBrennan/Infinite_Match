{
  "breakpoints": {
    "mobile_portrait": {
      "resolution": [720, 1280],
      "scale_factor": 0.8,
      "font_scale": 0.9,
      "spacing_scale": 0.8,
      "ui_adjustments": {
        "button_sizes": 0.9,
        "panel_padding": 0.8,
        "text_sizes": 0.9,
        "border_radius": 0.8,
        "shadow_intensity": 0.8
      },
      "layout_adjustments": {
        "top_bar_height": 100,
        "bottom_bar_height": 80,
        "panel_spacing": 12,
        "button_spacing": 8
      }
    },
    "mobile_landscape": {
      "resolution": [1280, 720],
      "scale_factor": 0.9,
      "font_scale": 1.0,
      "spacing_scale": 0.9,
      "ui_adjustments": {
        "button_sizes": 1.0,
        "panel_padding": 0.9,
        "text_sizes": 1.0,
        "border_radius": 0.9,
        "shadow_intensity": 0.9
      },
      "layout_adjustments": {
        "top_bar_height": 90,
        "bottom_bar_height": 70,
        "panel_spacing": 14,
        "button_spacing": 10
      }
    },
    "tablet_portrait": {
      "resolution": [768, 1024],
      "scale_factor": 1.0,
      "font_scale": 1.1,
      "spacing_scale": 1.0,
      "ui_adjustments": {
        "button_sizes": 1.1,
        "panel_padding": 1.0,
        "text_sizes": 1.1,
        "border_radius": 1.0,
        "shadow_intensity": 1.0
      },
      "layout_adjustments": {
        "top_bar_height": 120,
        "bottom_bar_height": 100,
        "panel_spacing": 16,
        "button_spacing": 12
      }
    },
    "tablet_landscape": {
      "resolution": [1024, 768],
      "scale_factor": 1.1,
      "font_scale": 1.2,
      "spacing_scale": 1.1,
      "ui_adjustments": {
        "button_sizes": 1.2,
        "panel_padding": 1.1,
        "text_sizes": 1.2,
        "border_radius": 1.1,
        "shadow_intensity": 1.1
      },
      "layout_adjustments": {
        "top_bar_height": 110,
        "bottom_bar_height": 90,
        "panel_spacing": 18,
        "button_spacing": 14
      }
    },
    "desktop": {
      "resolution": [1920, 1080],
      "scale_factor": 1.2,
      "font_scale": 1.3,
      "spacing_scale": 1.2,
      "ui_adjustments": {
        "button_sizes": 1.3,
        "panel_padding": 1.2,
        "text_sizes": 1.3,
        "border_radius": 1.2,
        "shadow_intensity": 1.2
      },
      "layout_adjustments": {
        "top_bar_height": 140,
        "bottom_bar_height": 120,
        "panel_spacing": 20,
        "button_spacing": 16
      }
    }
  },
  "adaptive_ui": {
    "enable_adaptive_ui": true,
    "enable_dynamic_scaling": true,
    "enable_content_fitting": true,
    "enable_safe_area": true,
    "enable_orientation_detection": true,
    "enable_device_detection": true
  },
  "accessibility": {
    "high_contrast_mode": {
      "enabled": true,
      "color_adjustments": {
        "background_contrast": 1.5,
        "text_contrast": 2.0,
        "button_contrast": 1.8
      }
    },
    "large_text_mode": {
      "enabled": true,
      "text_scale_multiplier": 1.5,
      "max_text_scale": 2.0
    },
    "color_blind_support": {
      "enabled": true,
      "protanopia_adjustments": true,
      "deuteranopia_adjustments": true,
      "tritanopia_adjustments": true
    },
    "screen_reader_support": {
      "enabled": true,
      "aria_labels": true,
      "semantic_markup": true
    },
    "keyboard_navigation": {
      "enabled": true,
      "tab_order": true,
      "focus_indicators": true
    }
  },
  "performance_optimizations": {
    "ui_batching": true,
    "texture_atlas_optimization": true,
    "animation_pooling": true,
    "dynamic_ui_culling": true,
    "memory_management": {
      "ui_object_pooling": true,
      "texture_compression": true,
      "mesh_optimization": true
    }
  }
}