  "license": "MIT",
  "main": "src/server/index.js",
  "name": "infinite-match-unity-optimized",
  "scripts": {
    "build": "node scripts/build-level-client.js && tsc",
    "build:vercel": "echo 'Vercel build completed - WebGL files are already built'",
    "dev": "nodemon --exec ts-node src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src/ --ext .js,.ts",
    "lint:fix": "eslint src/ --ext .js,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json}\"",
    "health": "node scripts/health-check.js",
    "deploy": "npm run build && npm run start",
    "stripe:setup": "./scripts/setup-stripe-cli.sh",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "stripe:test": "node scripts/test-stripe-integration.js",
    "stripe:logs": "stripe logs tail",
    "offline:setup": "node scripts/setup-offline.js",
    "offline:verify": "node scripts/verify-offline.js",
    "offline:start": "docker-compose -f docker-compose.opensource.yml up -d && npm run dev"
  },
  "type": "module",
  "version": "1.0.0"
}
