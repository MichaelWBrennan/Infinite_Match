# Open-source services configuration
# Environment variables for the self-hosted, open-source stack
# (docker-compose.opensource.yml). Copy to `.env` and adjust.

# ---------------------------------------------------------------------------
# Data layer (PostgREST over PostgreSQL — no vendor database)
# ---------------------------------------------------------------------------
POSTGREST_URL=http://localhost:3001
POSTGREST_TOKEN=
# Legacy aliases still accepted by the app:
# SUPABASE_URL=http://localhost:3001
# SUPABASE_ANON_KEY=

POSTGRES_URL=postgresql://postgres:password@localhost:5432/match3game

# Durable economy store. `mongo` is the wire protocol name only — the stack
# serves it with FerretDB (Apache-2.0) on PostgreSQL, not MongoDB (SSPL).
MONGODB_URI=mongodb://localhost:27017/match3game

# Cache / queue broker: Valkey (BSD-3), Redis-protocol compatible.
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Object storage: MinIO (AGPL-3.0, S3-compatible)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=match3game

# ---------------------------------------------------------------------------
# Analytics: PostHog, self-hosted (MIT core). Leave keys empty to log only.
# ---------------------------------------------------------------------------
POSTHOG_API_KEY=
POSTHOG_PUBLIC_KEY=
POSTHOG_HOST=http://localhost:8000

# ---------------------------------------------------------------------------
# Error tracking: GlitchTip (MIT), Sentry-SDK-compatible. The @sentry/node
# SDK works unchanged against it.
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# AI: local models via Ollama (MIT) — no hosted AI vendor required.
# OPENAI_API_KEY is only needed for a hosted OpenAI-compatible endpoint.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Email: Mailpit SMTP catcher (MIT) in development
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@match3game.com

# ---------------------------------------------------------------------------
# Push notifications (PUSH_TRANSPORT: ntfy | webpush | fcm | log)
# ---------------------------------------------------------------------------
PUSH_TRANSPORT=ntfy
NTFY_URL=http://localhost:8081
NTFY_TOKEN=
# W3C Web Push (used when PUSH_TRANSPORT=webpush):
# VAPID_SUBJECT=mailto:ops@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
PROMETHEUS_ENDPOINT=http://localhost:9090
GRAFANA_URL=http://localhost:3002
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Security
JWT_SECRET=change-me-to-a-long-random-string
BCRYPT_SALT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d
